@model Car_Rental.Models.Booking
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>🔎 Booking Code Search</h2>

<form method="post" asp-action="Search" class="mt-3">
    <div class="input-group input-group-lg shadow-sm">
        <input type="text"
               name="bookingCode"
               class="form-control"
               placeholder="Enter Booking Code (ex: TBP4138)"
               required />

        <button type="submit" class="btn btn-primary px-4">
            🔍 Search
        </button>
    </div>
</form>

@if (Model != null)
{
    <div class="card shadow-lg border-0 mt-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                📄 Booking Details
            </h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-muted">Booking Code</h6>
                    <h4 class="fw-bold text-primary">@Model.BookingCode</h4>
                </div>

                <div class="col-md-6 text-md-end">
                    <span class="badge bg-success fs-6 px-3 py-2">
                        @Model.PaymentStatus
                    </span>
                </div>
            </div>

            <hr />

            <div class="row mb-2">
                <div class="col-md-6">
                    <strong>Customer:</strong><br />
                    @Model.CustomerName
                </div>

                <div class="col-md-6">
                    <strong>Email:</strong><br />
                    @Model.CustomerEmail
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-6">
                    <strong>Vehicle:</strong><br />
                    @Model.Car.Brand @Model.Car.Model
                </div>

                <div class="col-md-6">
                    <strong>Status:</strong><br />
                    <span class="badge bg-primary">
                        @Model.BookingStatus
                    </span>
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-6">
                    <strong>Start Date:</strong><br />
                    @Model.StartDate.ToString("MMMM dd, yyyy")
                </div>

                <div class="col-md-6">
                    <strong>End Date:</strong><br />
                    @Model.EndDate.ToString("MMMM dd, yyyy")
                </div>
            </div>

            <hr />

            <div class="row mt-3">
                <div class="col-md-6">
                    <h6>Total Amount</h6>
                    <h3 class="fw-bold text-success">
                        <p><strong>Total:</strong> @(Model.TotalAmount?.ToString("N2") ?? "0.00")</p>
                    </h3>
                </div>
            </div>

        </div>
    </div>
}