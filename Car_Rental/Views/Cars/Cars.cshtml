@model List<Car>

@{
    ViewData["Title"] = "Garage";
}

<div class="container py-5">

    <h3 class="fw-bold mb-4">Our Premium Garage</h3>

    <div class="row g-4">


        @foreach (var car in Model)
        {
            var imageName = (car.Brand + car.Model)
            .ToLower()
            .Replace(" ", "")
            .Replace("-", "");

            var imagePath = Url.Content("~/Images/cars/" + imageName + ".jpg");

            <div class="col-md-3">
                <div class="car-card">

                    <div class="image-container">
                        <img src="@imagePath"
                             onerror="this.src='/cars/default.jpg';"
                             class="car-img" />

                        @{
                            string badgeClass = car.Status switch
                            {
                                "Booked" => "bg-danger",
                                "Reserved" => "bg-warning text-dark",
                                _ => "bg-success"
                            };
                        }

                        <span class="status-badge @badgeClass">
                            @car.Status
                        </span>
                    </div>

                    <div class="p-3">

                        <h6 class="fw-bold mb-1">
                            @car.Brand @car.Model
                        </h6>

                        <small class="text-muted d-block">
                            📅 @car.Year
                        </small>

                        <small class="text-muted d-block">
                            🚗 @car.TransmissionType
                        </small>

                        <div class="mt-3 d-flex justify-content-between align-items-center">

                            <div>
                                <small class="text-muted">Rate</small>
                                <h6 class="fw-bold mb-0">
                                    ₱@car.DailyRate <small>/day</small>
                                </h6>
                            </div>

                            <a asp-controller="Booking"
                               asp-action="Create"
                               asp-route-carId="@car.CarId"
                               class="btn btn-warning btn-sm">
                                Book Now
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        }


    </div>
</div>